# Phase 2 ADO RAG - Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# LLM PROVIDER SELECTION
# =============================================================================
# Choose one: "ollama" (local) or "openrouter" (cloud)
LLM_PROVIDER=ollama

# =============================================================================
# OLLAMA SETTINGS (used when LLM_PROVIDER=ollama)
# =============================================================================
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:14b

# =============================================================================
# OPENROUTER SETTINGS (used when LLM_PROVIDER=openrouter)
# =============================================================================
# Get your API key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model format: "provider/model-name" (see https://openrouter.ai/models)
# Recommended: openai/gpt-4o-mini, anthropic/claude-3.5-haiku, meta-llama/llama-3.1-70b-instruct
LLM_MODEL=openai/gpt-4o-mini

# Optional: For OpenRouter leaderboard attribution
OPENROUTER_SITE_URL=https://github.com/yourusername/ses-rag
OPENROUTER_APP_NAME=SES-RAG-Phase2

# =============================================================================
# EMBEDDINGS (always local via sentence-transformers)
# =============================================================================
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# =============================================================================
# VECTOR STORE (ChromaDB)
# =============================================================================
CHROMA_PERSIST_DIR=./storage
CHROMA_COLLECTION_NAME=rag_poc_v1

# =============================================================================
# CHUNKING SETTINGS (tokens)
# =============================================================================
CHUNK_SIZE_PDF=450
CHUNK_OVERLAP_PDF=80
CHUNK_SIZE_URL=350
CHUNK_OVERLAP_URL=60
CHUNK_SIZE_CHAT=200
CHUNK_OVERLAP_CHAT=30

# ADO-specific chunking
CHUNK_SIZE_ADO=400
CHUNK_OVERLAP_ADO=70

# =============================================================================
# RETRIEVAL SETTINGS
# =============================================================================
TOP_K=5
RELEVANCE_THRESHOLD=0.5

# HyDE (Hypothetical Document Embeddings) - Phase 2 feature
HYDE_ENABLED=true
HYDE_TEMPERATURE=0.4

# =============================================================================
# AZURE DEVOPS INTEGRATION (Phase 2)
# =============================================================================
# Get these from your Azure DevOps organization
ADO_ORG_URL=https://dev.azure.com/yourorg
ADO_PROJECT=YourProject
ADO_PAT=your-personal-access-token  # Keep secret! Never commit.

# =============================================================================
# API SERVER
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8001

# =============================================================================
# STREAMLIT UI
# =============================================================================
STREAMLIT_PORT=8502